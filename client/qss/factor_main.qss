QWidget {
    background-color: #1e1e1e;
    font-family: Tahoma;
    font-size: 14px;
    color: #dddddd;
}
QLabel{
    background: transparent;
}
QTableWidget {
    background-color: #252525;
    alternate-background-color: #2e2e2e;
    border: none;
}
QTableWidget::item {
    padding: 6px;
}
QTableWidget::item:selected {
    background-color: #ff8c2a;
}
QHeaderView::section {
    background-color: #2b2b2b;
    padding: 6px;
    border: none;
    font-weight: bold;
}
QLabel#barcode-lbl{
    font-size: 20px;
    font-weight: bold;
}
QLineEdit {
    background-color: #2b2b2b;
    border: 2px solid #3c3c3c;
    border-radius: 10px;
    padding: 8px;
    font-size: 20px;
}
QLineEdit:focus {
    border-color: #ff8c2a;
}
QFrame#right-panel{
    padding: 8px;
}
QPushButton {
    background-color: #3a3a3a;
    border: 1px solid #555;
    border-radius: 14px;
    padding: 12px;
    font-size: 18px;
}
QPushButton:hover {
    background-color: #4a4a4a;
    border-color: #ff8c2a;
}
QPushButton:disabled {
    background-color: #141313;
    color: #777;
    border-color: #333;
}
QPushButton#btn-panel {
    background-color: #333333;
    font-size: 17px;
    min-height: 38px;
    padding: 8px 12px;
    border-radius: 12px;
}
QLabel#status-title{
    font-size: 20px;
}
QLabel#status-res{
    font-size: 20px;
}
QLabel#status-balance{
    color: #ff8c2a;
    font-size: 30px;
}
QFrame#status-bar{
    background: #2a2a2a;
    font-size: 30px;
    padding: 5px;
}