QWidget{
    background:#1e1e1e;
    font-family:Tahoma;
}
#cashTitle {
    font-size: 56px;
    font-weight: bold;
    color: white;
    margin-top: 25px;
}
QLineEdit{
    background:#2b2b2b;
    color:white;
    border:2px solid #3c3c3c;
    border-radius:10px;
    padding:8px;
    font-size:24px;
}
QLineEdit:focus {
    border-color: #ff8c2a;
}
QPushButton{
    background: #3a3a3a;
    color:white;
    border:1px solid #555;
    border-radius:12px;
    font-size:24px;
}
QPushButton:hover{
    background: #4a4a4a;
    border-color: #ff8c2a;
}
QPushButton:pressed{
    background: #2a2a2a;
    border-color: #ff8c2a;
}