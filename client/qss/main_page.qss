QWidget{
    background:#121212;
    color:white;
    font-size:16px;
}
#panel{
    background:#1e1e1e;
    border-left:3px solid #ff8c2a;
}
QPushButton{
    background:#333;
    border:1px solid #444;
    border-radius:10px;
    padding:10px;
    min-height:40px;
}
QPushButton:hover{
    background:#444;
    border-color:#ff8c2a;
}
QPushButton:pressed{
    background:#222;
}
QPushButton:disabled {
    background-color: #141313;
    color: #777;
    border-color: #333;
}
QLabel#image{
    background-color: white;
    border-radius: 50%; 
    padding: 10px;
    margin: 0 500px;
}
QLabel#circle-green{
    border-radius: 6px;
}